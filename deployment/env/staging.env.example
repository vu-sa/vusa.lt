# =============================================================================
# VU SA — staging (www.naujas.vusa.lt, {tenant}.naujas.vusa.lt)
# =============================================================================
# Lives at /var/www/vusa_lt_usr/data/www/naujas.vusa.lt/.env. After editing, run
# `php artisan config:cache && php artisan staging:verify-isolation`.
#
# Do NOT set these — config/*.php forces them whenever APP_ENV=staging, so a value here
# is silently ignored: REDIS_DB, REDIS_CACHE_DB, REDIS_PREFIX, CACHE_PREFIX, REDIS_QUEUE,
# SCOUT_PREFIX, MAIL_MAILER, UMAMI_WEBSITE_ID, FILES_READ_ONLY. BROADCAST_CONNECTION and VAPID_*
# are ignored too unless their STAGING_*_ENABLED switch below is on.
# Do NOT set VITE_*: the frontend is built in CI from the Staging GitHub environment.
# =============================================================================

APP_NAME="VU SA"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.naujas.vusa.lt
SESSION_DOMAIN=".naujas.vusa.lt"
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Staging guards
# -----------------------------------------------------------------------------
# HTTP Basic Auth in front of the whole site; set false only for an open testing session.
STAGING_USER=
STAGING_PASSWORD=
STAGING_BASIC_AUTH_ENABLED=true

# `staging:refresh-database` restores the newest production backup nightly. It refuses to
# run unless both expected values match the active connection exactly.
STAGING_SOURCE_BACKUP_DIR=/var/www/vusa_lt_usr/data/www/vusa.lt/storage/backups
STAGING_EXPECTED_DATABASE=
STAGING_EXPECTED_DB_USERNAME=
# Every other address becomes user{id}@staging.invalid on import.
STAGING_EMAIL_ALLOWLIST=
# Temporary: keep real emails so invited testers can sign in. Set false afterwards, then
# `config:cache` and `staging:refresh-database --scrub-only --skip-reindex`.
STAGING_PRESERVE_ACCOUNT_EMAILS=false

# -----------------------------------------------------------------------------
# Microsoft sign-in — redirect defaults to APP_URL/auth/microsoft/callback.
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SharePoint — the staging Entra app (Sites.Selected: write on the test site, read on the
# archive). Site, list and drive IDs default to the test site; the archive to production's.
# Set SHAREPOINT_READ_ONLY=true to freeze staging's SharePoint writes again.
# -----------------------------------------------------------------------------
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_READ_ONLY=false

# -----------------------------------------------------------------------------
# Realtime (Reverb) — staging's own `staging-reverb` supervisor program, never production's :6001.
# Use a fresh app id/key/secret; the browser side is REVERB_* in the Staging GitHub environment.
# -----------------------------------------------------------------------------
STAGING_BROADCASTING_ENABLED=false
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=6002
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6002

# -----------------------------------------------------------------------------
# Push notifications — a staging-only pair from `php artisan webpush:vapid`, not production's.
# -----------------------------------------------------------------------------
STAGING_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:it@vusa.lt
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Search — staging shares production's Typesense server; SCOUT_PREFIX keeps its indexes apart.
# -----------------------------------------------------------------------------
SCOUT_DRIVER=database
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=
TYPESENSE_ADMIN_SEARCH_KEY=
TYPESENSE_PUBLIC_HOST=
TYPESENSE_PUBLIC_PORT=
TYPESENSE_PUBLIC_PROTOCOL=

CARTO_API_KEY=
