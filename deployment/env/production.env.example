# =============================================================================
# VU SA — production (www.vusa.lt, {tenant}.vusa.lt)
# =============================================================================
# Lives at /var/www/vusa_lt_usr/data/www/vusa.lt/.env. After editing, run
# `php artisan config:cache` (a deploy does this too).
#
# Do NOT set VITE_*: the frontend is built in CI from the Production GitHub environment.
# Keys with a default in config/*.php are left out — add one only to change its value.
# =============================================================================

APP_NAME="VU SA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.vusa.lt
SESSION_DOMAIN=".vusa.lt"
# Unset means debug — 2-7 MB of logs a day.
LOG_LEVEL=info
TELESCOPE_ENABLED=false

DB_HOST=127.0.0.1
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=vusa@vusa.lt
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Microsoft sign-in — redirect defaults to APP_URL/auth/microsoft/callback.
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SharePoint — the production Entra app. Site, list and drive IDs default to production.
# -----------------------------------------------------------------------------
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Search — index through loopback; only the PUBLIC node is reachable from browsers.
# -----------------------------------------------------------------------------
SCOUT_DRIVER=database
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=
TYPESENSE_ADMIN_SEARCH_KEY=
TYPESENSE_PUBLIC_HOST=
TYPESENSE_PUBLIC_PORT=
TYPESENSE_PUBLIC_PROTOCOL=

# -----------------------------------------------------------------------------
# Reverb (server side; the browser side is VITE_REVERB_* in GitHub)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=
REVERB_SCHEME=https

# -----------------------------------------------------------------------------
# Push notifications — `php artisan webpush:vapid`; rotating the keys drops every subscription.
# -----------------------------------------------------------------------------
VAPID_SUBJECT=mailto:it@vusa.lt
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Umami — the API URL must include the baked-in BASE_PATH (/analytics).
# -----------------------------------------------------------------------------
UMAMI_SCRIPT_URL=https://www.vusa.lt/analytics/script.js
UMAMI_WEBSITE_ID=
UMAMI_API_URL=http://127.0.0.1:3001/analytics
UMAMI_USERNAME=
UMAMI_PASSWORD=

CARTO_API_KEY=
