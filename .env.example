# =============================================================================
# VU SA Environment Configuration
# =============================================================================
# This file serves as the template for both local development and staging.
#
# ENVIRONMENT TYPES:
#   local    - Local development with Docker/Sail
#   staging  - Staging server at naujas.vusa.lt (subdomains: {tenant}.naujas.vusa.lt)
#   production - Production server at vusa.lt
#
# SETUP:
#   1. Copy this file to .env
#   2. Run: php artisan key:generate (or ./vendor/bin/sail artisan key:generate)
#   3. Adjust values based on your environment (see STAGING notes below)
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="VU SA"
APP_ENV=local
APP_KEY=
# STAGING: Run `php artisan key:generate` on the staging server
APP_DEBUG=true
# STAGING: APP_DEBUG=false
APP_URL=https://www.vusa.test
# STAGING: APP_URL=https://www.naujas.vusa.lt

# =============================================================================
# Staging Access Protection (only used when APP_ENV=staging)
# =============================================================================
# HTTP Basic Auth credentials to protect the staging site from public access
STAGING_USER=
STAGING_PASSWORD=

# Nightly refresh of staging's database from production (`staging:refresh-database`).
# The command refuses to run unless APP_ENV=staging, and is only scheduled there.
#
# STAGING: STAGING_SOURCE_BACKUP_DIR=/var/www/vusa_lt_usr/data/www/vusa.lt/storage/backups
# Production and staging share a VPS, so this is a local path, not a transfer.
STAGING_SOURCE_BACKUP_DIR=
#
# Every user address outside this comma-separated list is rewritten to
# user{id}@staging.invalid on import. Keep it to people who need staging mail —
# staging's scheduler sends news every 15 min and meeting reminders every 30, so an
# unscrubbed address is a real email to a real student. MAIL_MAILER=log is the other
# half of that guard; keep both.
STAGING_EMAIL_ALLOWLIST=

# Required on staging. The destructive refresh command refuses to run unless both
# values exactly match the active database connection.
STAGING_EXPECTED_DATABASE=
STAGING_EXPECTED_DB_USERNAME=

# =============================================================================
# Database Configuration
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mariadb
# STAGING: DB_HOST=127.0.0.1 (or your database server IP)
DB_PORT=3306
DB_DATABASE=vusa
DB_USERNAME=root
DB_PASSWORD=root

# =============================================================================
# Logging
# =============================================================================
# The `stack` channel resolves to `daily` alone, so logs land in
# storage/logs/laravel-YYYY-MM-DD.log and self-prune after 14 days. (An older
# stack also wrote a single storage/logs/laravel.log; if that file still exists
# on a server it is orphaned and safe to delete — it reached 4.1 GB on
# production before anyone noticed.)
#
# LOG_LEVEL defaults to `debug`. Leaving it unset in production means every
# debug line is written — worth 2-7 MB a day. Set it to `info` (or `warning`)
# wherever you are not actively debugging.
# PRODUCTION / STAGING: LOG_LEVEL=info
LOG_LEVEL=debug

# =============================================================================
# Mail Configuration
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
# STAGING: Mail delivery is forced to the log driver.
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=vusa@vusa.lt
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# PWA Push Notifications (Web Push / VAPID)
# =============================================================================
# Generate keys with: php artisan webpush:vapid
# VAPID_SUBJECT should be mailto: or https:// URL identifying the server
VAPID_SUBJECT=mailto:it@vusa.lt
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =============================================================================
# Queue & Cache Configuration
# =============================================================================
QUEUE_CONNECTION=sync
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# =============================================================================
# Redis Configuration
# =============================================================================
# STAGING: Use different DB numbers to avoid cache conflicts with production
#   Production: REDIS_DB=0, REDIS_CACHE_DB=1
#   Staging:    REDIS_DB=2, REDIS_CACHE_DB=3
# STAGING: REDIS_HOST=127.0.0.1 (for server) or keep 'redis' for Docker
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# STAGING: Add REDIS_PREFIX=vusa_staging_ to namespace keys
# STAGING: REDIS_QUEUE=staging and CACHE_PREFIX=vusa_staging_cache_
REDIS_QUEUE=default

# =============================================================================
# Session Configuration
# =============================================================================
# The session domain must match your development domain for cookies to work
# across subdomains (e.g., mif.vusa.test shares cookies with www.vusa.test)
SESSION_DOMAIN=".vusa.test"
# STAGING: SESSION_DOMAIN=".naujas.vusa.lt"
# STAGING: Add SESSION_SECURE_COOKIE=true (HTTPS required)

# =============================================================================
# Microsoft OAuth Configuration
# =============================================================================
# Register your app at https://portal.azure.com
# STAGING: Add https://www.naujas.vusa.lt/auth/microsoft/callback as redirect URI
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost/auth/microsoft/callback
# STAGING: MICROSOFT_REDIRECT_URI=https://www.naujas.vusa.lt/auth/microsoft/callback

# =============================================================================
# Laravel Reverb / WebSockets Configuration
# =============================================================================
# Reverb is Laravel's first-party WebSocket server for real-time features.
# Generate random keys for production: `php artisan reverb:key:generate`
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=vusa-app
REVERB_APP_KEY=vusa-reverb-key
REVERB_APP_SECRET=vusa-reverb-secret
REVERB_HOST=reverb
# STAGING/PRODUCTION: REVERB_HOST=localhost (or your Reverb server hostname)
REVERB_PORT=6001
REVERB_SCHEME=http
# STAGING/PRODUCTION: REVERB_SCHEME=https (if using TLS termination via nginx)

# Frontend Reverb connection settings (Vite vars - set explicitly, no interpolation)
# In development with nginx proxy, use the main domain (nginx proxies /app to Reverb)
VITE_REVERB_APP_KEY=vusa-reverb-key
VITE_REVERB_HOST=www.vusa.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# NOTE: nginx proxies wss://www.vusa.test/app -> ws://reverb:6001/app

# =============================================================================
# Scout / Search Configuration
# =============================================================================
# Default driver is 'database' - only specific models (like Document) use Typesense
SCOUT_DRIVER=database
# STAGING: Add SCOUT_PREFIX=staging_ to separate indexes from production

# Typesense Configuration (for models that explicitly use Typesense)
# These are the nodes the SERVER uses. Keep them internal — indexing through a public,
# rate-limited reverse proxy is slow, gets throttled with 429s, and sends the admin API
# key out to the internet and back.
TYPESENSE_HOST=typesense
# STAGING: TYPESENSE_HOST=127.0.0.1
# PRODUCTION: TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PATH=
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_SEARCH_ONLY_KEY=
TYPESENSE_ADMIN_SEARCH_KEY=

# The node the BROWSER talks to for public search — the only one that must be publicly
# routable. Leave empty to reuse the node above (fine locally, where both are the same).
# PRODUCTION: set this to the public Typesense hostname.
TYPESENSE_PUBLIC_HOST=
TYPESENSE_PUBLIC_PORT=
TYPESENSE_PUBLIC_PROTOCOL=

# =============================================================================
# SharePoint Configuration
# =============================================================================
# ⚠️  STAGING WARNING: SharePoint is shared with production!
# Set SHAREPOINT_READ_ONLY=true to prevent modifications in staging
SHAREPOINT_READ_ONLY=false
# STAGING: SHAREPOINT_READ_ONLY=true

SHAREPOINT_CLIENT_ID=12345678-1234-1234-1234-123456789abc
SHAREPOINT_CLIENT_SECRET=fake-client-secret-for-testing
SHAREPOINT_REDIRECT_URI=http://localhost/auth/microsoft/sharepoint/callback
# STAGING: SHAREPOINT_REDIRECT_URI=https://www.naujas.vusa.lt/auth/microsoft/sharepoint/callback
SHAREPOINT_TENANT_ID=12345678-1234-1234-1234-123456789abc

SHAREPOINT_ARCHIVE_DRIVE_ID=fake-archive-drive-id

# Test Drive ID and settings
SHAREPOINT_VUSA_DRIVE_ID="b!QF4zsh65ykCLc-6vvOkr4AP0wmTErtxEnKFUYKdmKJHD3vACCR_ITqyg65Cx24FO"
SHAREPOINT_SITE_ID=b2335e40-b91e-40ca-8b73-eeafbce92be0
SHAREPOINT_LIST_ID=02f0dec3-1f09-4ec8-aca0-eb90b1db814e

VITE_SHAREPOINT_CLIENT_ID=${SHAREPOINT_CLIENT_ID}
VITE_SHAREPOINT_TENANT_ID=${SHAREPOINT_TENANT_ID}

# SharePoint file picker location (optional — defaults to the VU SR archive)
# VITE_SHAREPOINT_PICKER_BASE_URL=https://vustudentuatstovybe.sharepoint.com
# VITE_SHAREPOINT_PICKER_SITE_URL=https://vustudentuatstovybe.sharepoint.com/sites/vieningai
# VITE_SHAREPOINT_PICKER_LIST="Bendrai naudojami dokumentai"
# VITE_SHAREPOINT_PICKER_FOLDER="Dokumentų sistema"

# =============================================================================
# File Storage Configuration
# =============================================================================
# ⚠️  STAGING WARNING: File storage (storage/app/public) may be shared with production!
# Set FILES_READ_ONLY=true to prevent file uploads, deletes, moves in staging
FILES_READ_ONLY=false
# STAGING: FILES_READ_ONLY=true

# =============================================================================
# Development Tooling
# =============================================================================
# Telescope stores request/query/job data. Enabled here for local debugging;
# defaults to false so it stays off in production unless explicitly enabled.
TELESCOPE_ENABLED=true
# STAGING: TELESCOPE_ENABLED=false

# =============================================================================
# Umami Analytics (self-hosted, cookieless)
# =============================================================================
# Tracking is OFF whenever UMAMI_WEBSITE_ID is empty — that is how staging and CI
# stay out of the dataset. Only public pages are tracked; /mano is never tracked.
#
# Local: `sail up -d` starts Umami on http://localhost:3001 (admin / umami).
# Create a website there, then paste its ID below.
UMAMI_SCRIPT_URL=http://localhost:3001/script.js
UMAMI_WEBSITE_ID=
# STAGING: UMAMI_WEBSITE_ID=
# PRODUCTION: UMAMI_SCRIPT_URL=https://www.vusa.lt/analytics/script.js

# Server-to-server API access for the tenant statistics on the Svetainė dashboard.
# Leave UMAMI_API_URL empty to disable that section (it degrades to an empty state).
#
# Use loopback//internal hostnames, not the public URL. The value must include Umami's
# BASE_PATH when one was baked in at build time — production is built with
# BASE_PATH=/analytics, so its API lives at /analytics/api/... even on loopback.
UMAMI_API_URL=http://umami:3000
# PRODUCTION: UMAMI_API_URL=http://127.0.0.1:3001/analytics
UMAMI_USERNAME=
UMAMI_PASSWORD=
# The date tracking started; content older than this is flagged as having incomplete data.
UMAMI_DATA_SINCE=2026-07-26

# Local Umami container only (production runs natively under supervisor on FastPanel).
UMAMI_APP_SECRET=local-dev-secret
FORWARD_UMAMI_PORT=3001

# The frontend build reads VITE_SHAREPOINT_* and VITE_REVERB_* (set above); both are
# injected by the deploy workflow from GitHub environment secrets. VITE_ARCHYVAS_PASSWORD
# and VITE_ATSTOVAI_PASSWORD used to live here but nothing reads them any more.

# =============================================================================
# CARTO basemaps (padalinys selector + event location maps)
# =============================================================================
# CARTO now requires an API key on basemap tile requests. Shared to the frontend as
# the 'map.cartoApiKey' Inertia prop (not a VITE_ var) so rotating it needs no rebuild.
# Leave empty locally — the tiles still load, just with CARTO's rate-limited free tier.
CARTO_API_KEY=
