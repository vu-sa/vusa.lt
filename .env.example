# =============================================================================
# VU SA — local development (Sail)
# =============================================================================
# 1. cp .env.example .env
# 2. vendor/bin/sail up -d && vendor/bin/sail artisan key:generate
#
# Servers use their own templates: deployment/env/staging.env.example and
# deployment/env/production.env.example. Anything with a sensible default lives in
# config/*.php, not here — only add a key when you need a different value.
# =============================================================================

APP_NAME="VU SA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.vusa.test
# mif.vusa.test must share cookies with www.vusa.test.
SESSION_DOMAIN=".vusa.test"
SESSION_EXPIRE_ON_CLOSE=false
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=vusa
DB_USERNAME=root
DB_PASSWORD=root

QUEUE_CONNECTION=sync
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches everything: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=vusa@vusa.lt
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=true

# -----------------------------------------------------------------------------
# Microsoft sign-in (optional locally; password login works without it)
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SharePoint — use the *staging* Entra app, never production's. It can only write
# to the test site, which the site/list/drive IDs in config/filesystems.php default
# to outside production. Add https://www.vusa.test as an SPA redirect URI for it.
# -----------------------------------------------------------------------------
SHAREPOINT_CLIENT_ID=12345678-1234-1234-1234-123456789abc
SHAREPOINT_CLIENT_SECRET=fake-client-secret-for-testing
VITE_SHAREPOINT_CLIENT_ID=${SHAREPOINT_CLIENT_ID}
VITE_SHAREPOINT_TENANT_ID=7ac8575d-ef21-4c2f-a125-2c7a2ddb24d6

# -----------------------------------------------------------------------------
# Reverb (nginx proxies wss://www.vusa.test/app -> ws://reverb:6001/app)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=vusa-app
REVERB_APP_KEY=vusa-reverb-key
REVERB_APP_SECRET=vusa-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=vusa-reverb-key
VITE_REVERB_HOST=www.vusa.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# -----------------------------------------------------------------------------
# Search — only models that override searchableUsing() go to Typesense.
# -----------------------------------------------------------------------------
SCOUT_DRIVER=database
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PATH=
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_SEARCH_ONLY_KEY=
TYPESENSE_ADMIN_SEARCH_KEY=

# -----------------------------------------------------------------------------
# Push notifications — generate with `sail artisan webpush:vapid` if you need them.
# -----------------------------------------------------------------------------
VAPID_SUBJECT=mailto:it@vusa.lt
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Umami — `sail up -d` starts it on http://localhost:3001 (admin / umami). Create a
# website there and paste its ID to test tracking; empty disables it.
# -----------------------------------------------------------------------------
UMAMI_SCRIPT_URL=http://localhost:3001/script.js
UMAMI_WEBSITE_ID=
UMAMI_API_URL=http://umami:3000
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_DATA_SINCE=2026-07-26
UMAMI_APP_SECRET=local-dev-secret
FORWARD_UMAMI_PORT=3001

# Empty is fine locally: tiles load on CARTO's rate-limited free tier.
CARTO_API_KEY=
