// VU SA palette, shared with the ataskaita2025 report: ink, amber and red on paper.
#let ink = rgb("#1A1A1A")
#let amber = rgb("#fbad13")
#let red = rgb("#b5333e")
#let paper = rgb("#faf8f5")
#let muted = rgb("#6b6b6b")
#let hairline = rgb("#dcd8d2")

// Typst falls back through the list, so the build works without Inter installed (e.g. in CI).
#let sans = ("Noto Sans", "Liberation Sans")
#let mono = "DejaVu Sans Mono"
