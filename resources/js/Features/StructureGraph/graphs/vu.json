    {"id":"node-rektorius","kind":"leader","label":{"lt":"Rektorius","en":"Vilnius University Rector"},"description":{"lt":"Vienasmenis Universiteto valdymo organas ir Universiteto vadovas. Rektorius veikia Universiteto vardu ir jam atstovauja, atsako už Universiteto veiklos tikslų įgyvendinimą, kokybišką darbų organizavimą, Universiteto finansinę veiklą, tinkamą lėšų ir turto valdymą.","en":"The University’s single-person governing body and head. The Rector acts on behalf of and represents the University, and is responsible for achieving its objectives, organising its work effectively, its financial activities and the proper management of funds and assets."},"url":"https://www.vu.lt/apiemus/struktura/rektorius","handles":["left-bottom","bottom","bottom-right","right-bottom","right"],"width":180,"position":{"x":0,"y":5}},
    {"id":"node-taryba","kind":"council","label":{"lt":"Taryba","en":"Vilnius University Council"},"description":{"lt":"Universiteto valdymo organas atsakingas už strateginę Universiteto plėtrą, veiklos kokybę, finansus bei struktūros pokyčius.","en":"The University’s governing body responsible for its strategic development, quality of activities, finances and structural changes."},"handles":["top-left","top","top-right","bottom"],"width":180,"position":{"x":-210,"y":80}},
    {"id":"node-senatas","kind":"council","label":{"lt":"Senatas","en":"Vilnius University Senate"},"description":{"lt":"Užtikrina kultūros, mokslo, tyrimų ir dėstymo laisvę Universitete, Universiteto bendrųjų akademinių reikalų ir kitų tiesiogiai su viso Universiteto akademine veikla susijusių klausimų kolegialų aptarimą bei jiems įgyvendinti reikalingų teisės aktų priėmimą.","en":"Ensures freedom of culture, science, research and teaching at the University, collegial discussion of general academic matters and other issues directly related to the University’s academic activities, and the adoption of the legal acts needed to implement them."},"handles":["top-left","top","right-top","right","right-bottom"],"width":180,"position":{"x":195,"y":80}},
    {"id":"node-senato-kolegija","kind":"council","label":{"lt":"Senato kolegija","en":"Senate Board"},"description":{"lt":"Senato veiklai organizuoti sudaroma Senato kolegija, susidedanti iš Senato pirmininko, Senato pirmininko pavaduotojo (-ų) ir Komitetų pirmininkų ir Studentų atstovo.","en":"The Senate Board organises the Senate’s work. It consists of the Senate Chairperson, Deputy Chairperson(s), committee chairs and a student representative."},"url":"https://www.vu.lt/apiemus/struktura/senatas/senato-reglamentas","handles":["left","top-left"],"position":{"x":465,"y":80}},
    {"id":"parent-node-mazasis-rektoratas","kind":"group","label":{"lt":"Mažasis rektoratas","en":"Small Rectorate"},"width":174,"height":166,"sourcePosition":"left","targetPosition":"top","position":{"x":-95,"y":140}},
    {"id":"node-didysis-rektoratas","kind":"council","label":{"lt":"Rektoratas","en":"Vilnius University Rectorate"},"description":{"lt":"Rektoriaus patariamasis darinys, sudarytas iš visų Universiteto kamieninių akademinių ir neakademinių padalinių vadovų bei Studentų atstovybės prezidento.","en":"An advisory body to the Rector, comprising the heads of all core academic and non-academic units of the University and the President of the Students’ Representation."},"handles":["top-right","left","bottom","right"],"width":180,"position":{"x":-370,"y":170}},
    {"id":"node-vicerektorius","kind":"leader","label":{"lt":"Vicerektorius (-ė)","en":"First Vice-Rector"},"description":{"lt":"Rektoriaus teikimu vieną iš prorektorių Taryba skiria eiti pirmojo prorektoriaus – vicerektoriaus – pareigas.","en":"On the Rector’s nomination, the Council appoints one of the Pro-Rectors as First Vice-Rector."},"handles":["left"],"position":{"x":12,"y":30},"parentNode":"parent-node-mazasis-rektoratas","width":150,"height":36},
    {"id":"node-kancleris","kind":"leader","label":{"lt":"Kancleris (-ė)","en":"Chancellor"},"description":{"lt":"Kancleris padeda Rektoriui valdyti Universiteto išteklius, tvarkyti finansus, užtikrinti Universiteto vidaus tvarką ir reikiamas materialines bei organizacines sąlygas Universiteto Senato ir Tarybos veiklai.","en":"The Chancellor assists the Rector in managing University resources and finances, maintaining internal order and ensuring the material and organisational conditions required for the Senate and Council to operate."},"handles":["left"],"position":{"x":12,"y":74},"parentNode":"parent-node-mazasis-rektoratas","width":150,"height":36},
    {"id":"node-prorektoriai","kind":"leader","label":{"lt":"Prorektoriai","en":"Pro-Rectors"},"description":{"lt":"Prorektoriai – administruoja Rektoriaus jiems pavestą Universiteto veiklos ar valdymo sritį.","en":"Pro-Rectors administer the areas of University activity or management assigned to them by the Rector."},"handles":[],"position":{"x":12,"y":118},"parentNode":"parent-node-mazasis-rektoratas","width":150,"height":36},
    {"id":"parent-node-senato-komitetai","kind":"group","label":{"lt":"Senato komitetai","en":"Senate Committees"},"description":{"lt":"Itin svarbiems su mokslu, menu ir studijomis susijusiems Universiteto veiklos klausimams spręsti yra sudaryti trys Senato komitetai: Mokslo, Studijų bei Kokybės ir plėtros. Kiekvienas komitetas nagrinėja atitinkamos srities klausimus bei teikia išvadas Senatui.","en":"Three Senate committees address particularly important University matters concerning research, art and studies: Research, Studies, and Quality and Development. Each examines matters in its field and submits conclusions to the Senate."},"width":174,"height":190,"sourcePosition":"left","targetPosition":"left","position":{"x":450,"y":140}},
    {"id":"node-studiju-komitetas","kind":"body","label":{"lt":"Studijų komitetas","en":"Studies Committee"},"description":{"lt":"Nagrinėja klausimus, susijusius su studijų vykdymu ir kokybe Vilniaus universitete","en":"Examines matters concerning the delivery and quality of studies at Vilnius University."},"handles":[],"position":{"x":12,"y":134},"parentNode":"parent-node-senato-komitetai","width":150,"height":44},
    {"id":"node-kokybes-ir-pletros-komitetas","kind":"body","label":{"lt":"Kokybės ir plėtros komitetas","en":"Quality and Development Committee"},"description":{"lt":"Kontroliuoja, kaip veikia studijų kokybės užtikrinimo sistema, nagrinėja su Vilniaus universiteto vidaus išteklių paskirstymu, plėtra susijusius klausimus.","en":"Monitors the study quality assurance system and examines matters concerning the allocation of internal resources and development at Vilnius University."},"handles":[],"width":150,"position":{"x":12,"y":30},"parentNode":"parent-node-senato-komitetai","height":44},
    {"id":"node-mokslo-komitetas","kind":"body","label":{"lt":"Mokslo komitetas","en":"Research Committee"},"description":{"lt":"Nagrinėja klausimus, susijusius su mokslo vykdymu bei plėtra Vilniaus universitete","en":"Examines matters concerning the conduct and development of research at Vilnius University."},"handles":[],"position":{"x":12,"y":82},"parentNode":"parent-node-senato-komitetai","width":150,"height":44},
    {"id":"parent-node-senato-komisijos","kind":"group","label":{"lt":"Senato komisijos","en":"Senate Commissions"},"description":{"lt":"Senato komisijos yra Senato sudarytos komisijos, padedančios įgyvendinti Universiteto tikslus bei uždavinius.","en":"Senate commissions are established by the Senate to help achieve the University’s goals and objectives."},"width":332,"height":232,"sourcePosition":"left","targetPosition":"left","position":{"x":450,"y":380}},
    {"id":"node-apk","kind":"body","label":{"lt":"Akademinio protokolo komisija","en":"Academic Protocol Commission"},"description":{"lt":"Kuria ir nuolatos atnaujina akademinių apeigų protokolą bei akademinių renginių aprašus.","en":"Develops and regularly updates the protocol for academic ceremonies and descriptions of academic events."},"url":"https://www.vu.lt/site_files/Akademiniu_apeigu_protokolas.pdf","handles":[],"width":150,"position":{"x":12,"y":30},"parentNode":"parent-node-senato-komisijos","height":58},
    {"id":"node-aek","kind":"body","label":{"lt":"Centrinė akademinės etikos komisija","en":"Central Academic Ethics Committee"},"description":{"lt":"Sprendžia ginčus bei klausimus, susijusius su akademinės etikos pažeidimais, kuria ir nuolatos atnaujina VU akademinės etikos kodeksą.","en":"Resolves disputes and issues concerning breaches of academic ethics, and develops and regularly updates the VU Code of Academic Ethics."},"url":"https://www.vu.lt/apiemus/dokumentai#akademine-etika","handles":[],"width":150,"position":{"x":170,"y":30},"parentNode":"parent-node-senato-komisijos","height":58},
    {"id":"node-gnk","kind":"body","label":{"lt":"Centrinė ginčų nagrinėjimo komisija","en":"Central Dispute Resolution Commission"},"description":{"lt":"Nagrinėja skundus bei pareiškimus tarp Universiteto bendruomenės narių, nesusijusius su akademinės etikos pažeidimais.","en":"Examines complaints and submissions concerning disputes between members of the University community that do not involve breaches of academic ethics."},"url":"https://www.vu.lt/apiemus/dokumentai#akademine-etika","handles":[],"width":150,"position":{"x":12,"y":96},"parentNode":"parent-node-senato-komisijos","height":58},
