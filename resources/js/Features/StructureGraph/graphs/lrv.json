    {"id":"node-seimas","kind":"council","label":{"lt":"Lietuvos Respublikos Seimas","en":"Seimas of the Republic of Lithuania"},"description":{"lt":"Lietuvos Respublikos Seimas yra įstatymų leidžiamoji valdžia.","en":"The Seimas of the Republic of Lithuania is the legislative branch of government."},"url":"https://www.lrs.lt/sip/portal.show?p_r=35354","handles":["right","bottom","left"],"width":210,"position":{"x":375,"y":-170}},
    {"id":"node-lrv","kind":"council","label":{"lt":"Lietuvos Respublikos Vyriausybė","en":"Government of the Republic of Lithuania"},"description":{"lt":"Vyriausybė – tai Lietuvos Respublikos įstatymų vykdomoji valdžia. Vyriausybė sudaro 14 ministerijų ministrai ir ministras pirmininkas, Seimo paskirti ketverių metų kadencijai.","en":"The Government is the executive branch of the Republic of Lithuania. It comprises the ministers of 14 ministries and the Prime Minister, appointed by the Seimas for a four-year term."},"handles":["top","left-top","left","left-bottom","bottom","right-bottom","right","right-top"],"width":210,"position":{"x":-10,"y":50}},
