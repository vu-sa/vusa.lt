    {"id":"node-pavaldzios-istaigos","kind":"body","label":{"lt":"Pavaldžios įstaigos","en":"Subordinate Agencies"},"handles":["top","top-left"],"position":{"x":-120,"y":250}},
    {"id":"node-ministras-pirmininkas","kind":"leader","label":{"lt":"Ministras Pirmininkas","en":"Prime Minister"},"description":{"lt":"Ministras Pirmininkas atstovauja Vyriausybei ir vadovauja jos veiklai, teikia Seimui svarstyti Vyriausybės programą, pirmininkauja Vyriausybės posėdžiams.","en":"The Prime Minister represents the Government and leads its activities, submits the Government programme to the Seimas for consideration and chairs Government meetings."},"handles":["left","left-bottom","bottom","right-bottom","right"],"position":{"x":400,"y":70}},
    {"id":"node-kancleris","kind":"leader","label":{"lt":"Vyriausybės kancleris","en":"Chancellor of the Government"},"description":{"lt":"Vyriausybės kancleris organizuoja Vyriausybei ir Ministrui Pirmininkui pateiktų teisės aktų projektų analizę ir derinimą, organizuoja Vyriausybės posėdžių rengimą ministerijų atstovų pasitarimus.","en":"The Chancellor of the Government organises the analysis and coordination of draft legal acts submitted to the Government and the Prime Minister, the preparation of Government meetings and meetings of ministry representatives."},"url":"https://lrvk.lrv.lt/lt/vyriausybes-kancleris","handles":["top","bottom","left"],"width":180,"position":{"x":400,"y":180}},
    {"id":"node-kanceliarija","kind":"body","label":{"lt":"Vyriausybės kanceliarija","en":"Office of the Government"},"description":{"lt":"Vyriausybės kanceliarija padeda vykdyti Vyriausybės ir Ministro Pirmininko funkcijas.","en":"The Office of the Government assists in carrying out the functions of the Government and the Prime Minister."},"url":"https://lrvk.lrv.lt/lt/vyriausybes-kanceliarijos-struktura","handles":["top","left"],"width":180,"position":{"x":470,"y":340}},
    {"id":"node-mp-darbo-grupes","kind":"body","label":{"lt":"Ministro Pirmininko sudaromos darbo grupės","en":"Working Groups Formed by the Prime Minister"},"description":{"lt":"Ministras Pirmininkas gali sudaryti darbo grupes jo pavestoms užduotims atlikti. Šios darbo grupės gali būti sudaromos iš valstybės ir savivaldybių institucijų ir įstaigų, asociacijų, mokslo ir studijų institucijų atstovų, nepriklausomų ekspertų.","en":"The Prime Minister may form working groups to carry out assigned tasks. They may comprise representatives of state and municipal institutions and agencies, associations, higher education and research institutions, and independent experts."},"handles":["top","left"],"width":210,"position":{"x":730,"y":65}},
    {"id":"node-mp-biuras","kind":"body","label":{"lt":"Ministro Pirmininko biuras","en":"Prime Minister’s Office"},"description":{"lt":"Organizuoja susitikimus ir renginius, kuriuose dalyvauja Ministras Pirmininkas.","en":"Organises meetings and events attended by the Prime Minister."},"url":"https://lrvk.lrv.lt/lt/vyriausybes-kanceliarijos-struktura","handles":["left"],"width":180,"position":{"x":730,"y":185}},
    {"id":"node-mp-patarejai","kind":"body","label":{"lt":"Ministro Pirmininko patarėjai","en":"Advisers to the Prime Minister"},"description":{"lt":"Ministro Pirmininko patarėjai – politinio pasitikėjimo valstybės tarnautojai, kurie pataria Ministrui Pirmininkui atitinkamų sričių klausimais, pagal savo ekspertinius laukus.","en":"Advisers to the Prime Minister are civil servants appointed on the basis of political confidence who advise the Prime Minister on matters within their respective areas of expertise."},"url":"https://ministraspirmininkas.lrv.lt/lt/ministres-pirmininkes-komanda","handles":["left"],"width":180,"position":{"x":730,"y":340}},
